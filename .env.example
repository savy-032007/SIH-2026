# ---------------------------------------------------------------------------
# APAAR platform — local development configuration
# Copy to `.env` and keep it out of git. All values below are DEV-ONLY.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=apaar
POSTGRES_PASSWORD=apaar_dev_password
POSTGRES_DB=apaar
# Host port for the dockerised Postgres (change if 5432 is taken locally)
POSTGRES_HOST_PORT=5432
# Used by the api container; host runs would use localhost:${POSTGRES_HOST_PORT}
DATABASE_URL=postgresql+psycopg://apaar:apaar_dev_password@postgres:5432/apaar
# Separate database used by `make test`
TEST_DATABASE_URL=postgresql+psycopg://apaar:apaar_dev_password@postgres:5432/apaar_test

# --- Service ports --------------------------------------------------------
API_PORT=8000
MOCK_ABC_PORT=9001
WEB_PORT=3000

# --- Crypto (DEV KEYS — never reuse in any deployed environment) ----------
# 32 bytes, base64. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcyEhISE=
# Separate secret for the deterministic lookup hashes (HMAC-SHA256)
HASH_PEPPER=dev-only-hash-pepper-change-me
# Key provider: local | kms  (kms is a documented stub until AWS is wired up)
KEY_PROVIDER=local
KEY_ID=local-v1

# --- Auth -----------------------------------------------------------------
JWT_SECRET=dev-only-jwt-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
MFA_TOKEN_TTL_MINUTES=5
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=15
# Password for every seeded demo user (dev only; printed by `make seed`)
DEMO_USER_PASSWORD=Demo@1234

# --- Integration adapters -------------------------------------------------
# abc registry: mock | production   (production is an intentional stub)
ABC_REGISTRY_IMPL=mock
ABC_BASE_URL=http://mock-abc:9001
ABC_CLIENT_ID=aicte-apaar-dev
ABC_CLIENT_SECRET=dev-only-abc-secret
ABC_TIMEOUT_SECONDS=5
ABC_MAX_ATTEMPTS=3

# digilocker: mock | apisetu_sandbox  (apisetu_sandbox is an intentional stub —
# the API Setu sandbox endpoints are not yet confirmed; see SPEC 9.4)
DIGILOCKER_IMPL=mock
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_BASE_URL=https://sandbox.api-setu.in

# --- Mock ABC registry service -------------------------------------------
MOCK_ABC_DATASET=/data/seed/abc_registry.json
# 1 = add 50-300ms latency and 1% random 503s (proves retry/backoff).
# Tests set this to 0 for determinism.
MOCK_ABC_CHAOS=1

# --- App ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Synthetic data generator --------------------------------------------
SEED=20262026
GEN_INSTITUTIONS=100
GEN_STUDENTS=35000
